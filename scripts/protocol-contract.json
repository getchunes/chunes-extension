{
  "endpoint": "http://127.0.0.1:52846/tabs",
  "request": {
    "contentType": "application/json",
    "limits": {
      "bodyBytes": 32768,
      "tabs": 64,
      "titleUnicodeCharacters": 512,
      "trackUrlCharacters": 2048
    },
    "payloadKeys": ["enabled", "services", "tabs"],
