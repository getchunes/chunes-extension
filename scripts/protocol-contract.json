    "tabKeys": ["host", "mediaId", "title"],
    "trackUrlKey": "trackUrl",
    "appleTabPlaybackKeys": ["position", "duration", "playing", "sampledAt"],
    "pageMetadataKeys": ["title", "artist", "artwork"]
  },
  "response": {
    "markerHeader": "X-Chunes-Protocol",
    "markerValue": "5"
  }
}
